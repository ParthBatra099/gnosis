{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:demo": "vite --config vite.demo.config.ts --open /demo.html",
